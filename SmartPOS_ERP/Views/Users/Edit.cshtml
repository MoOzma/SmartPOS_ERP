@model SmartPOS_ERP.Models.StaffFormViewModel
@{
    ViewData["Title"] = "تعديل موظف";
}

<div class="form-stack">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-secondary py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="text-info mb-1"><i class="ti ti-user-edit me-2"></i>تعديل: @Model.DisplayName</h4>
                <p class="text-secondary small mb-0">اسم الدخول: @Model.Username</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">رجوع</a>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <partial name="_StaffForm" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">حفظ التعديلات</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <partial name="_StaffFormScripts" />
}

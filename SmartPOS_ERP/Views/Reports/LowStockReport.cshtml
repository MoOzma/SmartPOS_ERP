@model IEnumerable<SmartPOS_ERP.Models.Product>
@{
    ViewData["Title"] = "نواقص المخزن";
    var items = Model.ToList();
    var emptyCount = items.Count(p => p.StockQuantity <= 0);
    var belowCount = items.Count - emptyCount;
}

<div class="page-head">
    <div>
        <h3 class="page-title"><i class="ti ti-alert-triangle"></i> تقرير نواقص المخزن <help-tip>الأصناف التي وصلت لحد إعادة الطلب أو نفدت. حد الطلب يُضبط من تعديل الصنف.</help-tip></h3>
        <p class="page-sub">أصناف وصلت لحد إعادة الطلب أو نفدت.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="ti ti-arrow-right me-1"></i>لوحة التحكم
        </a>
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary rounded-pill">
            <i class="ti ti-printer me-1"></i>طباعة
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">عدد النواقص <help-tip>كل الأصناف المتتبَّع مخزونها التي وصلت لحد الطلب أو نفدت.</help-tip></div>
            <p class="stat-value @(items.Count > 0 ? "text-danger" : "")">@items.Count</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">نفد تماماً <help-tip>أصناف كميتها صفر أو أقل. يلزم توريد فوري.</help-tip></div>
            <p class="stat-value @(emptyCount > 0 ? "text-danger" : "")">@emptyCount</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">تحت حد الطلب <help-tip>ما زال في المخزن كمية، لكنها وصلت لحد إعادة الطلب أو أقل.</help-tip></div>
            <p class="stat-value @(belowCount > 0 ? "text-warning" : "")">@belowCount</p>
        </div>
    </div>
</div>

<div class="card table-card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0 text-center">
            <thead>
                <tr>
                    <th>المنتج</th>
                    <th>الباركود</th>
                    <th>الكمية الحالية</th>
                    <th>حد الطلب <help-tip>الكمية التي عندها يظهر الصنف هنا كنقص، حتى لا ينفد من المحل.</help-tip></th>
                    <th>الحالة</th>
                    <th>إجراء</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Name</td>
                        <td class="text-secondary">@item.Barcode</td>
                        <td class="text-warning fw-bold">@item.StockQuantity.ToString("N3") @(item.Unit == "Kilo" ? "كجم" : "قطعة")</td>
                        <td>@item.ReorderLevel</td>
                        <td>
                            @if (item.StockQuantity <= 0)
                            {
                                <span class="badge bg-danger">نفد تماماً</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">تحت حد الطلب</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Products" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary rounded-pill px-3">تعديل المخزون</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="empty-cell">لا توجد نواقص حالياً، المخزن في حالة جيدة.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

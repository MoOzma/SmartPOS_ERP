@{
    ViewData["Title"] = "أكثر المنتجات طلباً";
}

<div class="page-head">
    <div>
        <h3 class="page-title"><i class="ti ti-chart-line"></i> لوحة المبيعات <help-tip>مبيعات اليوم والشهر، وأكثر 5 أصناف طلباً حسب الكمية المباعة.</help-tip></h3>
        <p class="page-sub">اليوم والشهر وأكثر الأصناف حركة.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-label">مبيعات اليوم</div>
            <p class="stat-value app-money">@ViewBag.DailyTotal.ToString("N2") ج.م</p>
            <div class="small text-secondary">عدد العمليات: @ViewBag.DailyCount</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <div class="stat-label">مبيعات الشهر</div>
            <p class="stat-value app-money">@ViewBag.MonthlyTotal.ToString("N2") ج.م</p>
            <div class="small text-secondary">عدد العمليات: @ViewBag.MonthlyCount</div>
        </div>
    </div>
</div>

<div class="card table-card border-0 shadow-sm">
    <div class="card-header">أكثر 5 منتجات طلباً</div>
    <div class="card-body">
        @{
            var topProducts = ViewBag.TopProducts as IEnumerable<dynamic>;
        }
        @if (topProducts == null || !topProducts.Any())
        {
            <p class="text-secondary text-center py-4 mb-0">لا توجد مبيعات بعد لعرض الأكثر طلباً.</p>
        }
        else
        {
            foreach (var p in topProducts)
            {
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span>@p.ProductName</span>
                        <span class="app-money">@p.TotalQty.ToString("N2") @(p.Unit == "Kilo" ? "كجم" : "قطعة")</span>
                    </div>
                    <div class="progress" style="height: 12px;">
                        <div class="progress-bar" role="progressbar"
                             style="width: @( (p.TotalQty > 100) ? 100 : p.TotalQty )%"></div>
                    </div>
                    <div class="text-end small text-secondary mt-1">إجمالي الدخل: @p.TotalSales.ToString("N2") ج.م</div>
                </div>
            }
        }
    </div>
</div>

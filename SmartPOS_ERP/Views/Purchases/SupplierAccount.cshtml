@model SmartPOS_ERP.Models.Supplier

@{
    ViewData["Title"] = "كشف حساب مورد";
    decimal totalPurchases = Model.Invoices?.Where(i => !i.IsVoided).Sum(i => i.Details.Sum(d => d.PackageQuantity * d.PackageCost)) ?? 0;
    decimal totalPaid = Model.Payments?.Sum(p => p.AmountPaid) ?? 0;
    decimal totalReturns = Model.Returns?.SelectMany(r => r.Details ?? []).Sum(d => d.LineTotal) ?? 0;
    decimal balance = totalPurchases - totalPaid - totalReturns;
}

@if (TempData["Error"] is string payError)
{
    <div class="alert alert-danger">@payError</div>
}

<div class="page-head">
    <div>
        <h3 class="page-title"><i class="ti ti-user-dollar"></i> كشف حساب: @Model.Name</h3>
        <p class="page-sub">رقم الهاتف: @(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#paymentModal">
            <i class="ti ti-cash me-1"></i>تسجيل دفع
        </button>
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary rounded-pill">
            <i class="ti ti-printer"></i>
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">إجمالي المشتريات</div>
            <p class="stat-value">@totalPurchases.ToString("N2") ج.م</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">إجمالي المدفوعات</div>
            <p class="stat-value text-success">@totalPaid.ToString("N2") ج.م</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">مرتجعات التوريد</div>
            <p class="stat-value">@totalReturns.ToString("N2") ج.م</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">الرصيد المتبقي <help-tip>التوريد ناقص المدفوعات ومرتجعات التوريد. الموجب يعني عليك مبلغ.</help-tip></div>
            <p class="stat-value text-danger">@balance.ToString("N2") ج.م</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card table-card border-0 shadow-sm">
            <div class="card-header">سجل فواتير التوريد</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle text-center">
                    <thead>
                        <tr>
                            <th>رقم الفاتورة</th>
                            <th>التاريخ</th>
                            <th>القيمة</th>
                            <th>تفاصيل</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Invoices == null || !Model.Invoices.Any())
                        {
                            <tr><td colspan="4" class="empty-cell">لا توجد فواتير.</td></tr>
                        }
                        else
                        {
                            foreach (var inv in Model.Invoices.OrderByDescending(x => x.InvoiceDate))
                            {
                                <tr class="@(inv.IsVoided ? "text-secondary" : "")">
                                    <td>#@inv.Id @(inv.IsVoided ? "ملغاة" : "")</td>
                                    <td>@inv.InvoiceDate.ToString("yyyy-MM-dd")</td>
                                    <td class="fw-bold app-money">@inv.Details.Sum(d => d.PackageQuantity * d.PackageCost).ToString("N2")</td>
                                    <td><a asp-action="Details" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-primary rounded-pill">عرض</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card table-card border-0 shadow-sm">
            <div class="card-header">سجل السداد</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle text-center">
                    <thead>
                        <tr>
                            <th>التاريخ</th>
                            <th>المبلغ</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Payments == null || !Model.Payments.Any())
                        {
                            <tr><td colspan="3" class="empty-cell">لا توجد دفعات.</td></tr>
                        }
                        else
                        {
                            foreach (var pay in Model.Payments.OrderByDescending(x => x.PaymentDate))
                            {
                                <tr>
                                    <td class="small">@pay.PaymentDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-success fw-bold">@pay.AmountPaid.ToString("N2")</td>
                                    <td class="small">@pay.Notes</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="PaySupplier" method="post">
                <input type="hidden" name="supplierId" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title">تسجيل دفعة للمورد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">المبلغ المدفوع</label>
                        <input type="number" step="0.01" min="0.01" name="amount" class="form-control fs-4 text-center fw-bold" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تاريخ الدفعة</label>
                        <input type="date" name="paymentDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ملاحظات</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="نقداً، تحويل بنكي، شيك..."></textarea>
                    </div>
                    <div class="form-check">
                        <input type="hidden" name="fromCash" value="false" />
                        <input class="form-check-input" type="checkbox" name="fromCash" value="true" id="fromCash" checked>
                        <label class="form-check-label" for="fromCash">من صندوق الوردية <help-tip>ينقص رصيد الصندوق المتوقع. لو تحويل بنكي، ألغِ الخيار.</help-tip></label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">تأكيد الدفع</button>
                </div>
            </form>
        </div>
    </div>
</div>

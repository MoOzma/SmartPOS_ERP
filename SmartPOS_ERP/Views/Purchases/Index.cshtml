@model SmartPOS_ERP.Models.PurchaseInvoiceReportViewModel
@{
    ViewData["Title"] = "سجل فواتير المشتريات";
    var months = new[] { "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var isMonth = Model.PeriodKind == "month";
    var isRange = Model.PeriodKind == "range";
    var isDay = !isMonth && !isRange;
}

<div class="page-head">
    <div>
        <h3 class="page-title"><i class="ti ti-truck-delivery"></i> سجل فواتير المشتريات <help-tip>فواتير التوريد من الموردين. من هنا تتابع الكميات والتكلفة أو تلغي فاتورة بالخطأ.</help-tip></h3>
        <p class="page-sub">اختر يومًا أو شهرًا أو فترة من-إلى لعرض فواتير التوريد حسب المورد.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-outline-secondary rounded-pill no-print" onclick="window.print()">
            <i class="ti ti-printer me-1"></i>طباعة
        </button>
        <a asp-action="Create" class="btn btn-primary rounded-pill no-print">
            <i class="ti ti-plus me-1"></i>إضافة فاتورة توريد
        </a>
    </div>
</div>

<form asp-action="Index" method="get" class="form-section no-print" id="purchasePeriodForm">
    <h5 class="form-section-title"><i class="ti ti-calendar"></i> الفترة والبحث</h5>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <input type="radio" class="btn-check" name="period" id="periodDay" value="day" @(isDay ? "checked" : null)>
        <label class="btn btn-outline-primary rounded-pill" for="periodDay">يوم محدد</label>
        <input type="radio" class="btn-check" name="period" id="periodMonth" value="month" @(isMonth ? "checked" : null)>
        <label class="btn btn-outline-primary rounded-pill" for="periodMonth">شهر محدد</label>
        <input type="radio" class="btn-check" name="period" id="periodRange" value="range" @(isRange ? "checked" : null)>
        <label class="btn btn-outline-primary rounded-pill" for="periodRange">فترة من / إلى</label>
    </div>
    <div class="row g-3 align-items-end">
        <div class="col-md-4 js-day-fields">
            <label class="form-label" for="selectedDate">اليوم</label>
            <input type="date" id="selectedDate" name="selectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control">
        </div>
        <div class="col-md-3 js-month-fields">
            <label class="form-label" for="selectedMonth">الشهر</label>
            <select id="selectedMonth" name="selectedMonth" class="form-select">
                @for (int i = 1; i <= 12; i++)
                {
                    if (i == Model.SelectedMonth)
                    {
                        <option value="@i" selected>@months[i - 1]</option>
                    }
                    else
                    {
                        <option value="@i">@months[i - 1]</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 js-month-fields">
            <label class="form-label" for="selectedYear">السنة</label>
            <input type="number" id="selectedYear" name="selectedYear" value="@Model.SelectedYear" min="2000" max="2100" class="form-control">
        </div>
        <div class="col-md-3 js-range-fields">
            <label class="form-label" for="fromDate">من</label>
            <input type="date" id="fromDate" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control">
        </div>
        <div class="col-md-3 js-range-fields">
            <label class="form-label" for="toDate">إلى</label>
            <input type="date" id="toDate" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control">
        </div>
        <div class="col-md-4">
            <label class="form-label" for="q">بحث</label>
            <input type="search" id="q" name="q" value="@Model.Query" class="form-control" placeholder="اسم المورد أو رقم الفاتورة">
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 rounded-pill">عرض</button>
        </div>
    </div>
</form>

<p class="text-secondary mb-3">نتائج <strong>@Model.PeriodLabel</strong></p>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">عدد الفواتير <help-tip>عدد فواتير التوريد في الفترة المختارة، بدون الفواتير الملغاة.</help-tip></div>
            <p class="stat-value">@Model.InvoiceCount</p>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">إجمالي القيمة <help-tip>مجموع تكلفة البضاعة المورَّدة في الفترة (سعر الشراء × الكمية).</help-tip></div>
            <p class="stat-value app-money">@Model.TotalAmount.ToString("N2") ج.م</p>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">عدد الموردين <help-tip>كم مورداً ظهرت له فواتير توريد في الفترة المختارة.</help-tip></div>
            <p class="stat-value">@Model.SupplierCount</p>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">أعلى مورد <help-tip>المورد صاحب أكبر قيمة توريد في الفترة.</help-tip></div>
            <p class="stat-value">@(string.IsNullOrWhiteSpace(Model.TopSupplier) ? "—" : Model.TopSupplier)</p>
        </div>
    </div>
</div>

<div class="card table-card border-0 shadow-sm mb-4">
    <div class="card-header">المشتريات حسب المورد <help-tip>توزيع قيمة التوريد على الموردين. النسبة = قيمة المورد ÷ إجمالي الفترة × 100.</help-tip></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle text-center">
            <thead>
                <tr>
                    <th>المورد</th>
                    <th>عدد الفواتير</th>
                    <th>القيمة</th>
                    <th>النسبة <help-tip>حصة هذا المورد من إجمالي توريد الفترة.</help-tip></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Suppliers.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="empty-cell">لا توجد فواتير توريد في الفترة المحددة.</td>
                    </tr>
                }
                @foreach (var supplier in Model.Suppliers)
                {
                    <tr>
                        <td class="fw-bold text-info">
                            <a asp-action="SupplierAccount" asp-route-id="@supplier.SupplierId">@supplier.Name</a>
                        </td>
                        <td>@supplier.InvoiceCount</td>
                        <td class="app-money fw-bold">@supplier.Amount.ToString("N2") ج.م</td>
                        <td>@supplier.Percent.ToString("N1")%</td>
                    </tr>
                }
            </tbody>
            @if (Model.Suppliers.Count > 0)
            {
                <tfoot>
                    <tr class="fw-bold">
                        <td>الإجمالي</td>
                        <td>@Model.InvoiceCount</td>
                        <td class="app-money">@Model.TotalAmount.ToString("N2") ج.م</td>
                        <td>100%</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<div class="card table-card border-0 shadow-sm">
    <div class="card-header">تفاصيل الفواتير <help-tip>كل فاتورة توريد في الفترة: المورد والتاريخ والأصناف والقيمة. من الإجراءات تفتح التفاصيل أو تلغي الفاتورة.</help-tip></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>رقم الفاتورة</th>
                    <th>المورد</th>
                    <th>التاريخ</th>
                    <th>الأصناف</th>
                    <th>الوحدات</th>
                    <th>القيمة</th>
                    <th class="text-center no-print">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty-cell">لا توجد فواتير توريد في الفترة المحددة.</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-bold">#@item.Id @(item.IsVoided ? "ملغاة" : "")</td>
                        <td>
                            <a asp-action="SupplierAccount" asp-route-id="@item.SupplierId">@item.SupplierName</a>
                        </td>
                        <td>@item.InvoiceDate.ToString("yyyy/MM/dd")</td>
                        <td><span class="badge bg-secondary">@item.LineCount</span></td>
                        <td>@item.TotalUnits.ToString("N0")</td>
                        <td class="app-money fw-bold @(item.IsVoided ? "text-secondary text-decoration-line-through" : "")">@item.TotalAmount.ToString("N2") ج.م</td>
                        <td class="text-center no-print">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">عرض</a>
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.Items.Count > 0)
            {
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="4">إجمالي الفترة</td>
                        <td>@Model.TotalUnits.ToString("N0")</td>
                        <td class="app-money">@Model.TotalAmount.ToString("N2") ج.م</td>
                        <td class="no-print"></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<script>
    (function () {
        var dayRadio = document.getElementById('periodDay');
        var monthRadio = document.getElementById('periodMonth');
        var rangeRadio = document.getElementById('periodRange');
        var dayFields = document.querySelectorAll('.js-day-fields');
        var monthFields = document.querySelectorAll('.js-month-fields');
        var rangeFields = document.querySelectorAll('.js-range-fields');
        function sync() {
            var month = monthRadio && monthRadio.checked;
            var range = rangeRadio && rangeRadio.checked;
            dayFields.forEach(function (el) { el.classList.toggle('d-none', month || range); });
            monthFields.forEach(function (el) { el.classList.toggle('d-none', !month); });
            rangeFields.forEach(function (el) { el.classList.toggle('d-none', !range); });
        }
        if (dayRadio) dayRadio.addEventListener('change', sync);
        if (monthRadio) monthRadio.addEventListener('change', sync);
        if (rangeRadio) rangeRadio.addEventListener('change', sync);
        sync();
    })();
</script>

@model SmartPOS_ERP.Models.PurchaseViewModel
@using System.Text.Json
@using SmartPOS_ERP.Models
@{
    ViewData["Title"] = "توريد بضاعة";
    var catalog = ((IEnumerable<Product>)ViewBag.Products).Select(p => new
    {
        id = p.Id,
        name = p.Name,
        barcode = p.Barcode ?? "",
        unit = p.Unit,
        cost = p.CostPrice,
        sale = p.SalePrice,
        stock = p.StockQuantity
    });
    var catalogJson = JsonSerializer.Serialize(catalog);
}

<div class="page-head">
    <div>
        <h3 class="page-title"><i class="ti ti-truck-delivery"></i> توريد بضاعة للمخزن <help-tip>فاتورة شراء من المورد: تزيد المخزون وتحدّث سعر التكلفة. يلزم وردية مفتوحة.</help-tip></h3>
        <p class="page-sub">اختر المورد، ابحث بالباركود أو الاسم، ثم أضف الأصناف للفاتورة.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">سجل الفواتير</a>
    </div>
</div>

<p id="purchaseMessage" class="purchase-message text-danger mb-3" role="status"></p>

<section class="form-section">
    <h5 class="form-section-title"><i class="ti ti-building-store"></i> بيانات الفاتورة</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="supplierId">المورد</label>
            <select id="supplierId" class="form-select">
                <option value="">-- اختر المورد --</option>
                @foreach (var s in (IEnumerable<dynamic>)ViewBag.Suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="purchaseDate">تاريخ التوريد</label>
            <input type="date" id="purchaseDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")">
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="button" class="btn btn-outline-primary rounded-pill w-100" data-bs-toggle="modal" data-bs-target="#newSupplierModal">
                <i class="ti ti-user-plus me-1"></i>مورد جديد
            </button>
        </div>
    </div>
</section>

<div class="row g-4">
    <div class="col-md-5">
        <section class="form-section h-100">
            <h5 class="form-section-title"><i class="ti ti-barcode"></i> البحث عن الصنف</h5>
            <label class="form-label" for="productSearchInput">باركود أو اسم</label>
            <input id="productSearchInput" class="form-control" placeholder="امسح الباركود أو اكتب اسم الصنف" autocomplete="off">
            <div id="productResults" class="purchase-results" role="listbox"></div>
            <a asp-controller="Products" asp-action="Create" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill mt-3">
                <i class="ti ti-package-plus me-1"></i>إضافة منتج جديد
            </a>

            <div id="inputFormArea" class="mt-3" hidden>
                <h6 class="form-section-title mb-2">بيانات التوريد <span id="selectedUnitType" class="badge bg-info"></span></h6>
                <p class="text-secondary small mb-3">
                    <span id="selectedProductName" class="fw-bold"></span>
                    — المخزون الحالي: <span id="selectedStock"></span>
                </p>

                <div id="kiloFields" class="unit-group" hidden>
                    <div class="row g-2">
                        <div class="col-md-6 mb-2">
                            <label class="form-label" for="kiloQty">الوزن الوارد (كجم)</label>
                            <input type="number" id="kiloQty" class="form-control" placeholder="0.000" min="0.001" step="0.001">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label" for="kiloCost">سعر شراء الكيلو <help-tip>يُحدَّث متوسط تكلفة الكيلو في المخزن بعد حفظ الفاتورة.</help-tip></label>
                            <input type="number" id="kiloCost" class="form-control" placeholder="0.00" min="0.01" step="0.01">
                            <span class="form-hint">يُحدَّث سعر تكلفة المخزن من متوسط هذا الشراء.</span>
                        </div>
                        <div class="col-12">
                            <div class="detail-item mb-2">
                                <div class="lbl">إجمالي حساب المورد عن هذا الصنف</div>
                                <span id="kiloTotalLabel" class="app-money fw-bold fs-5">0.00</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="pieceFields" class="unit-group" hidden>
                    <div class="row g-2">
                        <div class="col-md-6 mb-2">
                            <label class="form-label" for="pkgQty">عدد العلب</label>
                            <input type="number" id="pkgQty" class="form-control" placeholder="0" min="1" step="1">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label" for="unitsPer">قطع/علبة</label>
                            <input type="number" id="unitsPer" class="form-control" value="1" min="0.001" step="1">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label" for="pkgCost">سعر العلبة <help-tip>تكلفة العلبة كاملة. سعر القطعة = هذا السعر ÷ عدد القطع في العلبة، ويُحدَّث في المخزن.</help-tip></label>
                            <input type="number" id="pkgCost" class="form-control" placeholder="0.00" min="0.01" step="0.01">
                            <span class="form-hint">يُحدَّث سعر تكلفة القطعة في المخزن من هذا السعر.</span>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label" for="singleUnitCost">سعر القطعة (شراء)</label>
                            <input type="number" id="singleUnitCost" class="form-control" readonly tabindex="-1">
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label" for="newSalePrice">سعر البيع للعميل</label>
                    <input type="number" id="newSalePrice" class="form-control fw-bold" min="0.01" step="0.01">
                    <span class="form-hint">يُحدَّث على كرت المنتج بعد حفظ الفاتورة.</span>
                </div>

                <button type="button" class="btn btn-primary w-100 rounded-pill fw-bold py-2 mt-3" id="addItemBtn">
                    <i class="ti ti-plus me-1"></i>إضافة الصنف للجدول
                </button>
            </div>
        </section>
    </div>

    <div class="col-md-7">
        <div class="card table-card border-0 shadow-sm">
            <div class="card-header">أصناف الفاتورة</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>الصنف</th>
                            <th>الكمية</th>
                            <th>التكلفة</th>
                            <th class="text-center">حذف</th>
                        </tr>
                    </thead>
                    <tbody id="purchaseTableBody"></tbody>
                </table>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 p-3 form-section mb-0">
            <div class="text-secondary">إجمالي المبلغ المستحق للمورد</div>
            <div class="app-money fw-bold fs-2"><span id="grandTotal">0.00</span> <small class="fs-6">ج.م</small></div>
        </div>
        <button type="button" class="btn btn-primary btn-lg w-100 rounded-pill mt-3 fw-bold" id="saveAllBtn">
            <i class="ti ti-device-floppy me-2"></i>حفظ الفاتورة وتحديث المخزون
        </button>
    </div>
</div>

<div class="modal fade" id="newSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تسجيل مورد جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="modalSupName">اسم المورد/الشركة</label>
                    <input type="text" id="modalSupName" class="form-control">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="modalSupPhone">رقم الهاتف</label>
                    <input type="text" id="modalSupPhone" class="form-control" dir="ltr">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary w-100 rounded-pill" id="quickSaveSupplierBtn">حفظ المورد</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const catalog = @Html.Raw(catalogJson);
        let items = [];
        let selectedProduct = null;
        const searchInput = document.getElementById('productSearchInput');
        const resultsEl = document.getElementById('productResults');

        function setMessage(text) {
            document.getElementById('purchaseMessage').textContent = text || '';
        }

        function unitLabel(unit) {
            return unit === 'Kilo' ? 'كجم' : 'قطعة';
        }

        function renderResults(list) {
            if (!list.length) {
                resultsEl.classList.remove('is-open');
                resultsEl.innerHTML = '';
                return;
            }
            resultsEl.innerHTML = list.map(function (p) {
                return '<button type="button" class="purchase-result" data-id="' + p.id + '">' +
                    '<span>' + p.name + (p.barcode ? ' <small class="text-secondary" dir="ltr">' + p.barcode + '</small>' : '') + '</span>' +
                    '<small class="text-secondary">' + p.stock + ' ' + unitLabel(p.unit) + '</small>' +
                    '</button>';
            }).join('');
            resultsEl.classList.add('is-open');
        }

        function findMatches(term) {
            const q = (term || '').trim().toLowerCase();
            if (!q) return [];
            return catalog.filter(function (p) {
                return (p.name || '').toLowerCase().indexOf(q) !== -1 ||
                    (p.barcode || '').toLowerCase() === q ||
                    (p.barcode || '').toLowerCase().indexOf(q) !== -1;
            }).slice(0, 8);
        }

        function selectProduct(product) {
            selectedProduct = product;
            searchInput.value = product.name;
            resultsEl.classList.remove('is-open');
            document.getElementById('inputFormArea').hidden = false;
            document.getElementById('selectedProductName').textContent = product.name;
            document.getElementById('selectedStock').textContent = product.stock + ' ' + unitLabel(product.unit);
            document.getElementById('selectedUnitType').textContent = product.unit === 'Kilo' ? 'وزن' : 'علب/قطع';
            document.getElementById('newSalePrice').value = product.sale;
            const isKilo = product.unit === 'Kilo';
            document.getElementById('kiloFields').hidden = !isKilo;
            document.getElementById('pieceFields').hidden = isKilo;
            if (isKilo) {
                document.getElementById('kiloCost').value = product.cost;
                document.getElementById('kiloQty').focus();
                calculateKiloTotal();
            } else {
                document.getElementById('unitsPer').value = '1';
                document.getElementById('pkgCost').value = product.cost;
                updatePieceCalculations();
                document.getElementById('pkgQty').focus();
            }
            setMessage('');
        }

        function trySelectFromSearch() {
            const term = searchInput.value.trim();
            if (!term) return;
            const exactBarcode = catalog.find(function (p) {
                return (p.barcode || '').toLowerCase() === term.toLowerCase();
            });
            if (exactBarcode) {
                selectProduct(exactBarcode);
                return;
            }
            const matches = findMatches(term);
            if (matches.length === 1) selectProduct(matches[0]);
            else renderResults(matches);
        }

        searchInput.addEventListener('input', function () {
            renderResults(findMatches(this.value));
        });
        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                trySelectFromSearch();
            }
        });
        resultsEl.addEventListener('click', function (e) {
            const btn = e.target.closest('.purchase-result');
            if (!btn) return;
            const product = catalog.find(function (p) { return String(p.id) === btn.getAttribute('data-id'); });
            if (product) selectProduct(product);
        });

        document.getElementById('pkgCost').addEventListener('input', updatePieceCalculations);
        document.getElementById('unitsPer').addEventListener('input', updatePieceCalculations);
        document.getElementById('addItemBtn').addEventListener('click', addItem);
        document.getElementById('saveAllBtn').addEventListener('click', saveAll);
        document.getElementById('quickSaveSupplierBtn').addEventListener('click', quickSaveSupplier);

        function updatePieceCalculations() {
            const cost = parseFloat(document.getElementById('pkgCost').value) || 0;
            const per = parseFloat(document.getElementById('unitsPer').value) || 1;
            document.getElementById('singleUnitCost').value = per ? (cost / per).toFixed(2) : '0.00';
        }

        function addItem() {
            if (!document.getElementById('supplierId').value) {
                setMessage('اختر المورد أولاً.');
                return;
            }
            if (!selectedProduct) {
                setMessage('اختر صنفًا من البحث.');
                return;
            }

            let packageQuantity;
            let unitsPerPackage;
            let packageCost;
            if (selectedProduct.unit === 'Kilo') {
                packageQuantity = parseFloat(document.getElementById('kiloQty').value) || 0;
                unitsPerPackage = 1;
                packageCost = parseFloat(document.getElementById('kiloCost').value);
                if (packageQuantity <= 0) { setMessage('أدخل الوزن الوارد.'); return; }
                if (isNaN(packageCost) || packageCost <= 0) { setMessage('سعر شراء الكيلو يجب أن يكون أكبر من صفر.'); return; }
            } else {
                packageQuantity = parseFloat(document.getElementById('pkgQty').value) || 0;
                unitsPerPackage = parseFloat(document.getElementById('unitsPer').value) || 1;
                packageCost = parseFloat(document.getElementById('pkgCost').value);
                if (packageQuantity <= 0) { setMessage('أدخل عدد العلب.'); return; }
                if (unitsPerPackage <= 0) { setMessage('أدخل عدد القطع في العلبة.'); return; }
                if (isNaN(packageCost) || packageCost <= 0) { setMessage('سعر العلبة يجب أن يكون أكبر من صفر.'); return; }
            }

            const sale = parseFloat(document.getElementById('newSalePrice').value);
            if (isNaN(sale) || sale <= 0) { setMessage('سعر البيع يجب أن يكون أكبر من صفر.'); return; }
            const unitCost = selectedProduct.unit === 'Kilo' ? packageCost : (packageCost / unitsPerPackage);
            if (sale <= unitCost) { setMessage('سعر البيع يجب أن يكون أكبر من سعر الشراء.'); return; }
            const existing = items.find(function (item) {
                return item.productId === selectedProduct.id && item.unitsPerPackage === unitsPerPackage;
            });
            if (existing) {
                existing.packageQuantity += packageQuantity;
                existing.packageCost = packageCost;
                existing.newSalePrice = isNaN(sale) ? existing.newSalePrice : sale;
                existing.totalUnits = existing.packageQuantity * existing.unitsPerPackage;
                existing.lineTotal = existing.packageQuantity * existing.packageCost;
            } else {
                items.push({
                    productId: selectedProduct.id,
                    name: selectedProduct.name,
                    unit: selectedProduct.unit,
                    packageQuantity: packageQuantity,
                    unitsPerPackage: unitsPerPackage,
                    packageCost: packageCost,
                    newSalePrice: isNaN(sale) ? selectedProduct.sale : sale,
                    totalUnits: packageQuantity * unitsPerPackage,
                    lineTotal: packageQuantity * packageCost
                });
            }
            renderTable();
            resetInputs();
            setMessage('');
            searchInput.focus();
        }

        function renderTable() {
            const body = document.getElementById('purchaseTableBody');
            if (!items.length) {
                body.innerHTML = '<tr><td colspan="4" class="empty-cell">لم تُضف أصناف بعد.</td></tr>';
                document.getElementById('grandTotal').innerText = '0.00';
                return;
            }
            let total = 0;
            body.innerHTML = items.map(function (item, index) {
                total += item.lineTotal;
                const suffix = item.unit === 'Kilo' ? 'كجم' : (item.unitsPerPackage > 1 ? 'علبة' : 'قطعة');
                return '<tr>' +
                    '<td class="ps-3">' + item.name +
                    '<small class="text-secondary d-block">سعر البيع: ' + Number(item.newSalePrice).toFixed(2) + ' ج.م</small></td>' +
                    '<td><input type="number" class="form-control form-control-sm" min="0.001" step="any" value="' + item.packageQuantity +
                    '" data-index="' + index + '" aria-label="كمية ' + item.name + '"> <small class="text-secondary">' + suffix + '</small></td>' +
                    '<td class="app-money fw-bold">' + item.lineTotal.toFixed(2) + ' ج.م</td>' +
                    '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger border-0" data-remove="' + index + '" aria-label="حذف ' + item.name + '"><i class="ti ti-x"></i></button></td>' +
                    '</tr>';
            }).join('');
            document.getElementById('grandTotal').innerText = total.toFixed(2);
        }

        document.getElementById('purchaseTableBody').addEventListener('change', function (e) {
            const input = e.target.closest('input[data-index]');
            if (!input) return;
            const index = parseInt(input.getAttribute('data-index'), 10);
            const qty = parseFloat(input.value) || 0;
            if (qty <= 0) {
                items.splice(index, 1);
            } else {
                items[index].packageQuantity = qty;
                items[index].totalUnits = qty * items[index].unitsPerPackage;
                items[index].lineTotal = qty * items[index].packageCost;
            }
            renderTable();
        });
        document.getElementById('purchaseTableBody').addEventListener('click', function (e) {
            const btn = e.target.closest('[data-remove]');
            if (!btn) return;
            items.splice(parseInt(btn.getAttribute('data-remove'), 10), 1);
            renderTable();
        });

        function resetInputs() {
            searchInput.value = '';
            document.getElementById('inputFormArea').hidden = true;
            document.getElementById('kiloQty').value = '';
            document.getElementById('pkgQty').value = '';
            selectedProduct = null;
        }

        async function quickSaveSupplier() {
            const nameInput = document.getElementById('modalSupName');
            const phoneInput = document.getElementById('modalSupPhone');
            if (!nameInput.value) { setMessage('يرجى إدخال اسم المورد'); return; }
            try {
                const response = await fetch('/Purchases/CreateQuickSupplier', {
                    method: 'POST',
                    headers: antiForgeryHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({ Name: nameInput.value, Phone: phoneInput.value })
                });
                if (response.ok) {
                    const result = await response.json();
                    const select = document.getElementById('supplierId');
                    select.add(new Option(result.name, result.id, true, true));
                    bootstrap.Modal.getInstance(document.getElementById('newSupplierModal')).hide();
                    nameInput.value = '';
                    phoneInput.value = '';
                    setMessage('');
                } else {
                    setMessage('تعذر حفظ المورد.');
                }
            } catch (e) {
                setMessage('تعذر حفظ المورد.');
            }
        }

        async function saveAll() {
            const supplierId = document.getElementById('supplierId').value;
            if (!supplierId) { setMessage('اختر المورد.'); return; }
            if (!items.length) { setMessage('أضف صنفًا واحدًا على الأقل.'); return; }
            document.getElementById('saveAllBtn').disabled = true;
            try {
                const response = await fetch('/Purchases/SavePurchase', {
                    method: 'POST',
                    headers: antiForgeryHeaders({ 'Content-Type': 'application/json' }),
                    body: JSON.stringify({
                        SupplierId: parseInt(supplierId, 10),
                        PurchaseDate: document.getElementById('purchaseDate').value,
                        Items: items.map(function (item) {
                            return {
                                ProductId: item.productId,
                                PackageQuantity: item.packageQuantity,
                                UnitsPerPackage: item.unitsPerPackage,
                                PackageCost: item.packageCost,
                                NewSalePrice: item.newSalePrice
                            };
                        })
                    })
                });
                if (response.ok) {
                    const payload = await response.json();
                    window.location = '/Purchases/Details/' + payload.id;
                    return;
                }
                let message = 'فشل الحفظ';
                try {
                    const err = await response.json();
                    message = err.message || err || message;
                } catch (_) { }
                setMessage(message);
            } catch (e) {
                setMessage('تعذر الاتصال بالخادم.');
            } finally {
                document.getElementById('saveAllBtn').disabled = false;
            }
        }

        const kiloQtyInput = document.getElementById('kiloQty');
        const kiloCostInput = document.getElementById('kiloCost');
        const kiloTotalLabel = document.getElementById('kiloTotalLabel');
        function calculateKiloTotal() {
            const qty = parseFloat(kiloQtyInput.value) || 0;
            const cost = parseFloat(kiloCostInput.value) || 0;
            kiloTotalLabel.innerText = (qty * cost).toFixed(2);
        }
        kiloQtyInput.addEventListener('input', calculateKiloTotal);
        kiloCostInput.addEventListener('input', calculateKiloTotal);
        renderTable();
    </script>
}

@model SmartPOS_ERP.Models.Expense

@{
    ViewData["Title"] = "تسجيل مصروف";
}

<div class="form-stack">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-secondary py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="text-info mb-1"><i class="ti ti-receipt me-2"></i>تسجيل مصروف جديد <help-tip>مصروف تشغيل (إيجار، كهرباء...) وليس شراء بضاعة. يظهر في تقرير الأرباح ويُخصم من الصافي.</help-tip></h4>
                <p class="text-secondary small mb-0">يسجّل المصروف في تقرير الأرباح. لو من الصندوق ينقص رصيد الوردية.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">رجوع</a>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
                <section class="form-section">
                    <h5 class="form-section-title"><i class="ti ti-tag"></i> بيانات المصروف</h5>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Category">نوع المصروف</label>
                        <select asp-for="Category" class="form-select">
                            <option value="إيجار">إيجار</option>
                            <option value="كهرباء/مياه">كهرباء / مياه</option>
                            <option value="أدوات تشغيل (أكياس/ورق)">أدوات تشغيل (أكياس/ورق)</option>
                            <option value="صيانة">صيانة</option>
                            <option value="نثريات">نثريات</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Description">الوصف</label>
                        <input asp-for="Description" class="form-control" placeholder="مثلاً: فاتورة كهرباء شهر فبراير" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" asp-for="Amount">المبلغ (ج.م)</label>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" asp-for="ExpenseDate">التاريخ</label>
                            <input asp-for="ExpenseDate" type="date" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="FromCash" class="form-check-input" />
                        <label class="form-check-label" asp-for="FromCash">من صندوق الوردية <help-tip>لو المبلغ خرج من درج الكاش، فعّله عشان ينقص رصيد الصندوق المتوقع. لو تحويل بنكي، ألغِ الخيار.</help-tip></label>
                    </div>
                </section>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">حفظ المصروف</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

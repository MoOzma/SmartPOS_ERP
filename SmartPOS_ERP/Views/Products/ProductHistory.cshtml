@model IEnumerable<ProductMovementViewModel>

@{
    ViewData["Title"] = $"سجل حركة: {ViewBag.ProductName}";
}

<div class="page-head">
    <div>
        <h3 class="page-title"><i class="ti ti-history"></i> سجل حركة: @ViewBag.ProductName <help-tip>كل دخول وخروج لهذا الصنف: بيع، توريد، مرتجع، أو تسوية جرد، مع الكمية قبل وبعد.</help-tip></h3>
        <p class="page-sub">كل عمليات الدخول والخروج لهذا الصنف.</p>
    </div>
    <div class="stat-card" style="min-width: 180px;">
        <div class="stat-label">الرصيد الحالي</div>
        <p class="stat-value app-money mb-0">@ViewBag.CurrentStock</p>
    </div>
</div>

<div class="card table-card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>التاريخ</th>
                    <th>العملية</th>
                    <th>الكمية</th>
                    <th>قبل</th>
                    <th>بعد</th>
                    <th>المرجع</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="empty-cell">لا توجد حركات مسجّلة لهذا المنتج.</td>
                    </tr>
                }
                @foreach (var move in Model)
                {
                    <tr>
                        <td>@move.Date.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="badge @(move.Type.Contains("بيع") ? "bg-danger" : "bg-success")">
                                @move.Type
                            </span>
                        </td>
                        <td class="fw-bold">@move.Quantity.ToString("N3")</td>
                        <td>@move.QuantityBefore.ToString("N3")</td>
                        <td>@move.QuantityAfter.ToString("N3")</td>
                        <td class="small text-info">@(string.IsNullOrEmpty(move.Reason) ? move.Reference : $"{move.Reason} — {move.Reference}")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

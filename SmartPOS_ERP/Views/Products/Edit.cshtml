@model SmartPOS_ERP.Models.Product

@{
    ViewData["Title"] = "تعديل منتج";
}

<div class="form-stack">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-secondary py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="text-info mb-1"><i class="ti ti-pencil me-2"></i>تعديل: @Model.Name</h4>
                <p class="text-secondary small mb-0">رقم المنتج #@Model.Id</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                <i class="ti ti-arrow-right me-1"></i>العودة للبيع
            </a>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <section class="form-section">
                    <h5 class="form-section-title"><i class="ti ti-id"></i> بيانات المنتج</h5>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label" asp-for="Name">اسم المنتج</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" asp-for="Barcode">الباركود <help-tip>رقم المنتج على العبوة. عند مسحه في شاشة البيع يُضاف الصنف مباشرة بدون كتابة الاسم.</help-tip></label>
                            <input asp-for="Barcode" class="form-control" dir="ltr" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                            <span class="form-hint">الاسم لا يتكرر. الباركود اختياري، وإن وُجد يجب ألا يتكرر.</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="UnitSelect">وحدة البيع <help-tip>قطعة: تُباع بالعدد. كيلو: تُباع بالوزن من الميزان في شاشة البيع.</help-tip></label>
                            <select asp-for="Unit" id="UnitSelect" class="form-select">
                                <option value="">-- اختر الوحدة --</option>
                                <option value="Piece">بالقطعة (عدد)</option>
                                <option value="Kilo">بالكيلو (ميزان)</option>
                            </select>
                            <span asp-validation-for="Unit" class="text-danger small"></span>
                        </div>
                        <partial name="_ProductCategoryFields" />
                    </div>
                </section>

                <section class="form-section">
                    <h5 class="form-section-title"><i class="ti ti-cash"></i> الأسعار والضريبة</h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label id="salePriceLabel" class="form-label" asp-for="SalePrice">سعر البيع (ج.م)</label>
                            <input asp-for="SalePrice" type="number" step="0.01" min="0.01" class="form-control" required />
                            <span asp-validation-for="SalePrice" class="text-danger small"></span>
                            <span class="form-hint">يجب أن يكون أعلى من سعر الشراء.</span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label id="costPriceLabel" class="form-label" asp-for="CostPrice">سعر الشراء (ج.م) <help-tip>تكلفة الصنف للمحل. يُستخدم لحساب الربح وقيمة المخزون. يتحدّث تلقائياً عند التوريد بمتوسط السعر.</help-tip></label>
                            <input asp-for="CostPrice" type="number" step="0.01" min="0.01" class="form-control" required />
                            <span asp-validation-for="CostPrice" class="text-danger small"></span>
                        </div>
                        <partial name="_ProductTaxFields" />
                    </div>
                </section>

                <section class="form-section">
                    <h5 class="form-section-title"><i class="ti ti-packages"></i> المخزون</h5>
                    <div class="form-switch-row mb-3">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" asp-for="TrackInventory" id="trackStock" />
                            <label class="form-check-label" for="trackStock">تتبع كمية هذا المنتج في المخزن <help-tip>عند التفعيل ينقص المخزون مع كل بيع ويمنع البيع بأكثر من المتاح. أطفئه للخدمات أو الأصناف التي لا تُعدّ.</help-tip></label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label id="stockLabel" class="form-label" asp-for="StockQuantity">الكمية الحالية</label>
                            <input asp-for="StockQuantity" type="number" step="0.001" min="0" class="form-control" required />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" asp-for="ReorderLevel">حد إعادة الطلب <help-tip>عندما تصل الكمية لهذا الرقم يظهر الصنف في تقرير نواقص المخزن لتنبيهك بالشراء.</help-tip></label>
                            <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                            <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                        </div>
                    </div>
                </section>

                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="ti ti-device-floppy me-1"></i>حفظ التعديلات
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const unitSelect = document.getElementById('UnitSelect');
            const saleLabel = document.getElementById('salePriceLabel');
            const costLabel = document.getElementById('costPriceLabel');
            const stockLabel = document.getElementById('stockLabel');
            function syncUnitLabels() {
                const unit = unitSelect.value;
                if (unit === 'Kilo') {
                    saleLabel.textContent = 'سعر الكيلو (بيع)';
                    costLabel.textContent = 'سعر الكيلو (شراء)';
                    stockLabel.textContent = 'الوزن الحالي (كجم)';
                } else if (unit === 'Piece') {
                    saleLabel.textContent = 'سعر القطعة (بيع)';
                    costLabel.textContent = 'سعر القطعة (شراء)';
                    stockLabel.textContent = 'الكمية الحالية (عدد)';
                }
            }
            unitSelect.addEventListener('change', syncUnitLabels);
            syncUnitLabels();

            const saleInput = document.getElementById('SalePrice');
            const costInput = document.getElementById('CostPrice');
            function syncMarkup() {
                const sale = parseFloat(saleInput.value);
                const cost = parseFloat(costInput.value);
                if (sale > 0 && cost > 0 && sale <= cost) {
                    saleInput.setCustomValidity('سعر البيع يجب أن يكون أكبر من سعر الشراء.');
                } else {
                    saleInput.setCustomValidity('');
                }
            }
            saleInput.addEventListener('input', syncMarkup);
            costInput.addEventListener('input', syncMarkup);
        })();
    </script>
}

@model SmartPOS_ERP.Models.Product

@{
    ViewData["Title"] = "إضافة منتج جديد";
}

<div class="form-stack">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-secondary py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="text-info mb-1"><i class="ti ti-package-plus me-2"></i>إضافة منتج جديد</h4>
                <p class="text-secondary small mb-0">أدخل بيانات الصنف مرة واحدة، ثم احفظه ليظهر في شاشة البيع.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                <i class="ti ti-arrow-right me-1"></i>العودة للبيع
            </a>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                <section class="form-section">
                    <h5 class="form-section-title"><i class="ti ti-id"></i> بيانات المنتج</h5>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label" for="Name">اسم المنتج</label>
                            <input asp-for="Name" class="form-control" placeholder="مثال: لبن كامل الدسم" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" for="Barcode">الباركود <help-tip>رقم المنتج على العبوة. عند مسحه في شاشة البيع يُضاف الصنف مباشرة بدون كتابة الاسم.</help-tip></label>
                            <input asp-for="Barcode" class="form-control" placeholder="اختياري" dir="ltr" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                            <span class="form-hint">الاسم لا يتكرر. الباركود اختياري، وإن وُجد يجب ألا يتكرر.</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="UnitSelect">وحدة البيع <help-tip>قطعة: تُباع بالعدد. كيلو: تُباع بالوزن من الميزان في شاشة البيع.</help-tip></label>
                            <select asp-for="Unit" id="UnitSelect" class="form-select" required>
                                <option value="Piece">بالقطعة (عدد)</option>
                                <option value="Kilo">بالكيلو (ميزان)</option>
                            </select>
                            <span asp-validation-for="Unit" class="text-danger small"></span>
                            <span class="form-hint">تحدد طريقة إدخال الكمية في شاشة البيع.</span>
                        </div>
                        <partial name="_ProductCategoryFields" />
                    </div>
                </section>

                <section class="form-section" id="pieceCartonFields">
                    <h5 class="form-section-title"><i class="ti ti-box"></i> بيانات الكرتون <help-tip>سعر شراء القطعة = سعر الكرتون ÷ عدد القطع. هذا الرقم هو أساس حساب الربح. الكمية = عدد الكراتين × القطع.</help-tip></h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label" for="CartonCount">عدد الكراتين</label>
                            <input asp-for="CartonCount" type="number" step="1" min="0" class="form-control" />
                            <span asp-validation-for="CartonCount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" for="CartonPrice">سعر الكرتون (ج.م)</label>
                            <input asp-for="CartonPrice" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="CartonPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label" for="PiecesPerCarton">عدد القطع في الكرتون</label>
                            <input asp-for="PiecesPerCarton" type="number" step="1" min="1" class="form-control" />
                            <span asp-validation-for="PiecesPerCarton" class="text-danger small"></span>
                        </div>
                    </div>
                </section>

                <section class="form-section">
                    <h5 class="form-section-title"><i class="ti ti-cash"></i> الأسعار والضريبة</h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label id="salePriceLabel" class="form-label" for="SalePrice">سعر البيع (ج.م)</label>
                            <input asp-for="SalePrice" type="number" step="0.01" min="0.01" class="form-control" required />
                            <span asp-validation-for="SalePrice" class="text-danger small"></span>
                            <span class="form-hint">يجب أن يكون أعلى من سعر شراء القطعة.</span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label id="costPriceLabel" class="form-label" for="CostPrice">سعر الشراء (ج.م) <help-tip>تكلفة القطعة للمحل. تُحسب من سعر الكرتون ÷ عدد القطع، وتُستخدم لحساب الربح. يمكنك زيادتها لا خفضها عن الناتج.</help-tip></label>
                            <input asp-for="CostPrice" type="number" step="0.01" min="0.01" class="form-control" required />
                            <span asp-validation-for="CostPrice" class="text-danger small"></span>
                            <span id="costHint" class="form-hint">يظهر تلقائياً من سعر الكرتون ÷ عدد القطع.</span>
                        </div>
                        <partial name="_ProductTaxFields" />
                    </div>
                </section>

                <section class="form-section">
                    <h5 class="form-section-title"><i class="ti ti-packages"></i> المخزون</h5>
                    <div class="form-switch-row mb-3">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" asp-for="TrackInventory" id="trackStock" />
                            <label class="form-check-label" for="trackStock">تتبع كمية هذا المنتج في المخزن <help-tip>عند التفعيل ينقص المخزون مع كل بيع ويمنع البيع بأكثر من المتاح. أطفئه للخدمات أو الأصناف التي لا تُعدّ.</help-tip></label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label id="stockLabel" class="form-label" for="StockQuantity">الكمية المتوفرة</label>
                            <input asp-for="StockQuantity" type="number" step="0.001" min="0" class="form-control" required />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="ReorderLevel">حد إعادة الطلب <help-tip>عندما تصل الكمية لهذا الرقم يظهر الصنف في تقرير نواقص المخزن لتنبيهك بالشراء.</help-tip></label>
                            <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                            <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                            <span class="form-hint">ينبّهك التقرير عندما تصل الكمية لهذا الحد.</span>
                        </div>
                    </div>
                </section>

                <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="ti ti-device-floppy me-1"></i>حفظ المنتج
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const unitSelect = document.getElementById('UnitSelect');
            const saleLabel = document.getElementById('salePriceLabel');
            const costLabel = document.getElementById('costPriceLabel');
            const stockLabel = document.getElementById('stockLabel');
            const cartonFields = document.getElementById('pieceCartonFields');
            const cartonCount = document.getElementById('CartonCount');
            const cartonPrice = document.getElementById('CartonPrice');
            const piecesPer = document.getElementById('PiecesPerCarton');
            const saleInput = document.getElementById('SalePrice');
            const costInput = document.getElementById('CostPrice');
            const stockInput = document.getElementById('StockQuantity');
            const costHint = document.getElementById('costHint');

            function pieceUnitCost() {
                const price = parseFloat(cartonPrice.value);
                const pcs = parseFloat(piecesPer.value);
                if (!(price > 0) || !(pcs > 0)) return null;
                return Math.round((price / pcs) * 100) / 100;
            }

            function syncUnitLabels() {
                const unit = unitSelect.value;
                const isPiece = unit === 'Piece';
                cartonFields.hidden = !isPiece;
                cartonPrice.required = isPiece;
                piecesPer.required = isPiece;
                if (unit === 'Kilo') {
                    saleLabel.textContent = 'سعر الكيلو (بيع)';
                    costLabel.textContent = 'سعر الكيلو (شراء)';
                    stockLabel.textContent = 'الوزن الحالي (كجم)';
                    costHint.textContent = 'تكلفة الكيلو للمحل. تُستخدم لحساب الربح.';
                } else {
                    saleLabel.textContent = 'سعر القطعة (بيع)';
                    costLabel.textContent = 'سعر القطعة (شراء)';
                    stockLabel.textContent = 'الكمية الحالية (عدد)';
                    costHint.textContent = 'يظهر تلقائياً من سعر الكرتون ÷ عدد القطع.';
                }
            }

            function fillFromCarton() {
                if (unitSelect.value !== 'Piece') {
                    costInput.setCustomValidity('');
                    return;
                }
                const unitCost = pieceUnitCost();
                if (unitCost != null) {
                    costInput.value = unitCost.toFixed(2);
                    const count = parseFloat(cartonCount.value);
                    const pcs = parseFloat(piecesPer.value);
                    if (!isNaN(count) && count >= 0 && pcs > 0) {
                        stockInput.value = String(count * pcs);
                    }
                }
                syncCostFloor();
                syncMarkup();
            }

            function syncCostFloor() {
                const unitCost = pieceUnitCost();
                const cost = parseFloat(costInput.value);
                if (unitSelect.value === 'Piece' && unitCost != null && cost > 0 && cost < unitCost) {
                    costInput.setCustomValidity('سعر القطعة أقل من ناتج سعر الكرتون ÷ عدد القطع، وهذا يضخّم الربح.');
                } else {
                    costInput.setCustomValidity('');
                }
            }

            function syncMarkup() {
                const sale = parseFloat(saleInput.value);
                const cost = parseFloat(costInput.value);
                if (sale > 0 && cost > 0 && sale <= cost) {
                    saleInput.setCustomValidity('سعر البيع يجب أن يكون أكبر من سعر الشراء.');
                } else {
                    saleInput.setCustomValidity('');
                }
            }

            unitSelect.addEventListener('change', function () {
                syncUnitLabels();
                fillFromCarton();
            });
            cartonCount.addEventListener('input', fillFromCarton);
            cartonPrice.addEventListener('input', fillFromCarton);
            piecesPer.addEventListener('input', fillFromCarton);
            costInput.addEventListener('input', function () {
                syncCostFloor();
                syncMarkup();
            });
            saleInput.addEventListener('input', syncMarkup);
            syncUnitLabels();
            fillFromCarton();
        })();
    </script>
}

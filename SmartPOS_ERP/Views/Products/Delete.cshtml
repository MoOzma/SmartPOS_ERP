@model SmartPOS_ERP.Models.Product

@{
    ViewData["Title"] = "حذف منتج";
}

<div class="form-stack">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-transparent border-secondary py-3">
            <h4 class="text-danger mb-0"><i class="ti ti-trash me-2"></i>تأكيد حذف المنتج</h4>
        </div>
        <div class="card-body p-4">
            <p class="mb-4">هل أنت متأكد من حذف <strong class="text-info">@Model.Name</strong>؟ لا يمكن التراجع عن هذا الإجراء.</p>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="detail-item">
                        <div class="lbl">الباركود</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.Barcode) ? "—" : Model.Barcode)</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <div class="lbl">سعر البيع</div>
                        <div class="app-money fw-bold">@Model.SalePrice.ToString("N2") ج.م</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-item">
                        <div class="lbl">المخزون</div>
                        <div>@Model.StockQuantity.ToString(Model.Unit == "Kilo" ? "N3" : "N0")</div>
                    </div>
                </div>
            </div>
            <form asp-action="Delete" class="d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger rounded-pill px-4">حذف المنتج</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">إلغاء</a>
            </form>
        </div>
    </div>
</div>

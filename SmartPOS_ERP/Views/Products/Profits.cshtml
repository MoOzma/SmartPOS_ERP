@model IEnumerable<SmartPOS_ERP.Models.MonthlyProfitViewModel>

@{
    ViewData["Title"] = "تقرير الأرباح والخسائر";
    var currentMonth = DateTime.Now.ToString("yyyy-MM");
    var currentData = Model.FirstOrDefault(m => m.Month == currentMonth);
    decimal monthProfit = currentData?.TotalProfit ?? 0;
    decimal monthSales = currentData?.TotalSales ?? 0;
}

<div class="page-head">
    <div>
        <h3 class="page-title"><i class="ti ti-chart-pie"></i> الأرباح والخسائر <help-tip>مقارنة شهرية: المبيعات مقابل الربح. يتحدّث تلقائياً من فواتير البيع والمصروفات.</help-tip></h3>
        <p class="page-sub">تحديث تلقائي بناءً على المبيعات والمصاريف.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-outline-secondary rounded-pill" onclick="window.print()">
            <i class="ti ti-printer me-1"></i>طباعة
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">مبيعات الشهر الحالي</div>
            <p class="stat-value app-money">@monthSales.ToString("N2") ج.م</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">صافي ربح الشهر <help-tip>ربح الشهر الحالي بعد تكلفة البضاعة والمصروفات.</help-tip></div>
            <p class="stat-value @(monthProfit >= 0 ? "text-success" : "text-danger")">@monthProfit.ToString("N2") ج.م</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">نسبة الربح <help-tip>صافي الربح ÷ مبيعات الشهر × 100.</help-tip></div>
            <p class="stat-value">@(monthSales > 0 ? ((monthProfit / monthSales) * 100).ToString("N1") : "0")%</p>
        </div>
    </div>
</div>

<div class="card table-card border-0 shadow-sm">
    <div class="card-header">تحليل الشهور السابقة</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle text-center">
            <thead>
                <tr>
                    <th>الشهر / السنة</th>
                    <th>إجمالي المبيعات</th>
                    <th>إجمالي التكلفة والمصاريف</th>
                    <th>صافي الربح</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-cell">لا توجد بيانات أرباح بعد.</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    var totalCosts = item.TotalSales - item.TotalProfit;
                    <tr>
                        <td class="fw-bold text-info">@item.Month</td>
                        <td>@item.TotalSales.ToString("N2")</td>
                        <td class="text-secondary">@totalCosts.ToString("N2")</td>
                        <td class="fw-bold @(item.TotalProfit >= 0 ? "text-success" : "text-danger")">
                            @item.TotalProfit.ToString("N2") ج.م
                        </td>
                        <td>
                            @if (item.TotalProfit >= 0)
                            {
                                <span class="badge bg-success">رابح</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">خاسر</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

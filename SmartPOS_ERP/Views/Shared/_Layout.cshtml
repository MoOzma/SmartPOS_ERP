@{
    var store = ViewData["StoreSettings"] as StoreSettings;
    var storeName = string.IsNullOrWhiteSpace(store?.StoreName) ? "Sama_POS" : store.StoreName;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @storeName</title>
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
    <script>
        (function () {
            var theme = localStorage.getItem('sama-theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
            if (localStorage.getItem('sama-sidebar') === 'collapsed') {
                document.documentElement.classList.add('sidebar-collapsed');
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="app-shell">
        <aside class="app-sidebar no-print d-none d-md-block">
            <partial name="_AppSidebarNav" model='"desk"' />
        </aside>

        <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="mobileSidebar">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title text-primary fw-bold">@storeName</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button>
            </div>
            <div class="offcanvas-body">
                <partial name="_AppSidebarNav" model='"mob"' />
            </div>
        </div>

        <div class="app-content">
            <header class="app-topbar no-print">
                <div class="d-flex align-items-center gap-2">
                    <button class="icon-btn d-none d-md-inline-flex" type="button" data-sidebar-toggle title="طي القائمة" aria-label="طي القائمة">
                        <i class="ti ti-layout-sidebar-right-collapse"></i>
                    </button>
                    <button class="icon-btn d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-label="القائمة">
                        <i class="ti ti-menu-2"></i>
                    </button>
                    <span class="fw-bold">@(ViewData["Title"] ?? "Sama_POS")</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="icon-btn" type="button" data-theme-toggle title="الوضع الداكن" aria-label="الوضع الداكن">
                        <i class="ti ti-moon-stars"></i>
                    </button>
                    <a asp-controller="Account" asp-action="Profile" class="app-user">
                        <i class="ti ti-user-circle"></i> @User.Identity?.Name
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill">
                        <i class="ti ti-logout"></i> خروج
                    </a>
                </div>
            </header>
            <main class="app-page @(ViewData["DensePage"] is true ? "app-page-dense" : "")">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ";
}

<div class="container py-5">
    <div class="card border-danger mx-auto" style="max-width: 560px;">
        <div class="card-body p-4">
            <h1 class="h4 text-danger mb-3">تعذر إتمام العملية</h1>
            <p class="mb-3">حدث خطأ أثناء معالجة الطلب. حاول مرة أخرى أو تواصل مع الدعم.</p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-secondary mb-0">رقم الطلب: <code>@Model.RequestId</code></p>
            }
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-info mt-4 rounded-pill">العودة لشاشة البيع</a>
        </div>
    </div>
</div>
